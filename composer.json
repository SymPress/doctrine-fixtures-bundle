{
    "name": "sympress/doctrine-fixtures-bundle",
    "description": "Native Doctrine data fixtures integration for SymPress, built on the original DoctrineFixturesBundle.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Brian Schäffner",
            "email": "brian.schaeffner@sympress.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "doctrine/data-fixtures": "^2.2",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "sympress/doctrine-bundle": "^1.0.5",
        "sympress/kernel": "^1.1.14"
    },
    "require-dev": {
        "phpstan/phpstan-doctrine": "^2.0",
        "sympress/qa": "^0.1.2"
    },
    "autoload": {
        "psr-4": {
            "SymPress\\DoctrineFixturesBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymPress\\DoctrineFixturesBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kernel": {
            "bundle": "SymPress\\DoctrineFixturesBundle\\DoctrineFixturesBundle",
            "entry": "doctrine-fixtures-bundle",
            "requires": [
                "sympress/doctrine-bundle"
            ]
        }
    },
    "scripts": {
        "lint:php": "qa lint:php",
        "cs": [
            "Composer\\Config::disableProcessTimeout",
            "qa cs --strict"
        ],
        "cs:fix": [
            "Composer\\Config::disableProcessTimeout",
            "qa cs:fix"
        ],
        "static-analysis": [
            "Composer\\Config::disableProcessTimeout",
            "qa static-analysis --strict"
        ],
        "tests": [
            "Composer\\Config::disableProcessTimeout",
            "qa tests --strict"
        ],
        "test": [
            "@tests"
        ],
        "qa": [
            "qa doctor --strict",
            "@lint:php",
            "@cs",
            "@static-analysis",
            "@tests"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "suggest": {
        "symfony/maker-bundle": "Generates fixture classes with make:fixtures through sympress/doctrine-bundle's optional MakerBundle adapter."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
